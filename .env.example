# Core app configuration
NODE_ENV=development
PORT=5173
APP_NAME=Fasl_ai_v2
VITE_API_BASE_URL=http://localhost:8006
API_PREFIX=/api
ENVIRONMENT=development

# PostgreSQL database configuration
POSTGRES_DB=educational_platform_v2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/educational_platform_v2
DATABASE_AUTO_INIT=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase PostgreSQL and private Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_MEDIA_BUCKET=course-materials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PRIVATE_MEDIA_BUCKET=course-materials

# Brevo account verification
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Fasl_ai
APP_PUBLIC_URL=http://localhost:5173

# Bunny Stream
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=

# JWT and optional production AI service
JWT_SECRET=
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://localhost:8002

# First administrator provisioning, used only by bootstrap_admin.py
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Frontend Vite env consumption
VITE_DATABASE_URL=sqlite:///./data/educational_platform_v2.db
